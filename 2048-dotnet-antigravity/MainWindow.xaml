<Window x:Class="_2048_dotnet_antigravity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:_2048_dotnet_antigravity.ViewModels"
        mc:Ignorable="d"
        Title="2048"
        Width="420"
        Height="445"
        MinWidth="400"
        MinHeight="400"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#92877d"
        Focusable="True">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#8f7a66" />
            <Setter Property="Foreground" Value="#f9f6f2" />
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9e8a76" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7a6755" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#92877d">
        <!-- Starting Menu -->
        <Grid Visibility="{Binding IsMenuVisible, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                <TextBlock Text="2048"
                           FontFamily="Verdana"
                           FontWeight="Bold"
                           FontSize="48"
                           Foreground="#f9f6f2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15" />

                <TextBlock Text="Grid Size (2 - 10):"
                           FontFamily="Verdana"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#f9f6f2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBox x:Name="GridSizeBox"
                         Text="{Binding GridSizeInput, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Verdana"
                         FontWeight="Bold"
                         FontSize="20"
                         Width="90"
                         Height="40"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"
                         Background="#eee4da"
                         Foreground="#776e65"
                         BorderThickness="0"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,5" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#f65e3b"
                           FontFamily="Verdana"
                           FontWeight="Bold"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Start"
                            Style="{StaticResource GameButtonStyle}"
                            Command="{Binding StartGameCommand}"
                            IsDefault="True"
                            Width="95"
                            Height="40"
                            Margin="5" />

                    <Button Content="Exit"
                            Style="{StaticResource GameButtonStyle}"
                            Command="{Binding QuitCommand}"
                            IsCancel="True"
                            Width="95"
                            Height="40"
                            Margin="5" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Game Board -->
        <Viewbox Stretch="Uniform"
                 Visibility="{Binding IsGameVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400"
                    Height="400"
                    Background="#92877d"
                    Padding="5">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding GridSize}" Columns="{Binding GridSize}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TileViewModel}">
                            <Border Margin="5"
                                    Background="{Binding BackgroundBrush}">
                                <Viewbox MaxHeight="52" MaxWidth="76" Margin="4">
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontFamily="Verdana"
                                               FontWeight="Bold"
                                               Foreground="{Binding ForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Viewbox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Viewbox>
    </Grid>
</Window>
