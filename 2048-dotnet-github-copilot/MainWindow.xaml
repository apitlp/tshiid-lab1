<Window x:Class="Game2048.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2048"
        Width="450"
        Height="535"
        MinWidth="400"
        MinHeight="485"
        Background="#faf8ef"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Up"
                Command="{Binding UpCommand}"/>
        <KeyBinding Key="W"
                Command="{Binding UpCommand}"/>
        <KeyBinding Key="I"
                Command="{Binding UpCommand}"/>
        <KeyBinding Key="Down"
                Command="{Binding DownCommand}"/>
        <KeyBinding Key="S"
                Command="{Binding DownCommand}"/>
        <KeyBinding Key="K"
                Command="{Binding DownCommand}"/>
        <KeyBinding Key="Left"
                Command="{Binding LeftCommand}"/>
        <KeyBinding Key="A"
                Command="{Binding LeftCommand}"/>
        <KeyBinding Key="J"
                Command="{Binding LeftCommand}"/>
        <KeyBinding Key="Right"
                Command="{Binding RightCommand}"/>
        <KeyBinding Key="D"
                Command="{Binding RightCommand}"/>
        <KeyBinding Key="L"
                Command="{Binding RightCommand}"/>
        <KeyBinding Key="B"
                Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Escape"
                Command="{Binding QuitCommand}"/>
    </Window.InputBindings>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="2048"
                FontFamily="Verdana"
                FontSize="48"
                FontWeight="Bold"
                Foreground="#776e65"/>
        <TextBlock Grid.Row="1"
                Text="{Binding Status}"
                Height="30"
                FontFamily="Verdana"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#776e65"
                HorizontalAlignment="Center"/>

        <Border Grid.Row="2"
                Background="#92877d"
                CornerRadius="6"
                Padding="10"
                Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4"
                                Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}"
                                CornerRadius="4"
                                Margin="5">
                            <TextBlock Text="{Binding DisplayValue}"
                                       Foreground="{Binding Foreground}"
                                       FontFamily="Verdana"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>